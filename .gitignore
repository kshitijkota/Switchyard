__pycache__/
*.pyc
.pytest_cache/
.DS_Store
*.egg-info/
.venv/
venv/
.env
# Generated 200k logs — regenerated by verify.py, too large to track
/data/*.jsonl

# SQLite idempotency store (runtime state)
*.db
*.sqlite
*.sqlite3

# Recovery audit trail — regenerated on every run
/artifacts/audit.jsonl

# Diagnosis cache: COMMIT the LLM caches (openai + gemini) so the diagnosis
# numbers reproduce with no key; the offline/anthropic caches + incident log are
# per-run and ignored.
/diagnose/cache/statistical_*.json
/diagnose/cache/trained_*.json
/diagnose/cache/anthropic_*.json
/diagnose/cache/*.log

# transient run logs
artifacts/*.log
