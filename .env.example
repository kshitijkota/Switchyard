# Switchyard — diagnosis LLM configuration (TASK 2).
# Copy to .env and fill in keys. .env is gitignored; NEVER commit real keys.
# Keys are read from the environment only.

# --- Primary: Gemini (used for the whole diagnosis run) ---
GEMINI_API_KEY=
# Model is resolved as GEMINI_MODEL, then LLM_MODEL_gemini, then a hardcoded
# default — never from a shared LLM_MODEL (which could send a Gemini name to
# OpenAI). Both provider-scoped names are honoured:
GEMINI_MODEL=gemini-3.8-flash
LLM_MODEL_gemini=gemini-3.8-flash

# --- Fallback: OpenAI (ONLY on a non-rate-limit Gemini failure) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MODEL_openai=gpt-4o-mini

# --- Shared ---
LLM_MAX_RPM=60
